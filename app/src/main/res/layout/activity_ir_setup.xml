<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Step 1: pick brand -->
    <LinearLayout
        android:id="@+id/brand_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="IR remote"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pick your TV brand. Works offline with any TV – no Wi-Fi needed."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_app"
            android:hint="Search brand"
            android:inputType="textCapWords|textNoSuggestions"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <ListView
            android:id="@+id/brands"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@android:color/transparent" />
    </LinearLayout>

    <!-- Step 2: test codes -->
    <LinearLayout
        android:id="@+id/test_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/t_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/t_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/t_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical">
                <ImageButton android:id="@+id/t_power" style="@style/RBtn" android:layout_width="80dp" android:layout_height="80dp"
                    android:background="@drawable/bg_power" android:contentDescription="Test power" android:src="@drawable/ic_power" android:tint="#FFFF5A5F" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="Power" android:textColor="@color/muted" android:textSize="12sp" />
            </LinearLayout>

            <Space android:layout_width="24dp" android:layout_height="1dp" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical">
                <ImageButton android:id="@+id/t_vol" style="@style/RBtn" android:layout_width="80dp" android:layout_height="80dp"
                    android:contentDescription="Test volume up" android:src="@drawable/ic_vol_up" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="Vol +" android:textColor="@color/muted" android:textSize="12sp" />
            </LinearLayout>

            <Space android:layout_width="24dp" android:layout_height="1dp" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical">
                <ImageButton android:id="@+id/t_mute" style="@style/RBtn" android:layout_width="80dp" android:layout_height="80dp"
                    android:contentDescription="Test mute" android:src="@drawable/ic_mute" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="Mute" android:textColor="@color/muted" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/t_works"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_primary"
            android:gravity="center"
            android:text="✓  The TV responded – use this"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/t_prev" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:background="@drawable/bg_app" android:gravity="center" android:text="◀  Previous"
                android:textColor="@color/text" android:textSize="15sp" />

            <Space android:layout_width="10dp" android:layout_height="1dp" />

            <TextView android:id="@+id/t_next" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:background="@drawable/bg_app" android:gravity="center" android:text="No response – next  ▶"
                android:textColor="@color/text" android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/t_auto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_flat"
            android:gravity="center"
            android:text="▶  Auto-try every code"
            android:textColor="@color/accent"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
